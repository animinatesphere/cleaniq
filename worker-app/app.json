{
  "expo": {
    "name": "Cleaniq",
    "slug": "cleaniq-worker",
    "scheme": "cleaniqworker",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C43"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleaniq.worker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cleaniq.worker",
      "adaptiveIcon": {
        "backgroundColor": "#0A5C43",
        "foregroundImage": "./assets/icon.jpg"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-updates",
        {
          "username": "hexcode"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1e50a75-2559-4534-a471-6e975bdeccbc"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c1e50a75-2559-4534-a471-6e975bdeccbc",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    }
  }
}
