{
  "expo": {
    "name": "Cleaniq Services Pro",
    "slug": "cleaniq-worker",
    "scheme": "cleaniqworker",
    "version": "1.2.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C43"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleaniq.worker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Cleaniq uses your location, only while you have it switched on for a job, so the customer can see when you're on the way."
      }
    },
    "android": {
      "package": "com.cleaniq.worker",
      "adaptiveIcon": {
        "backgroundColor": "#0A5C43",
        "foregroundImage": "./assets/icon.jpg"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-updates",
        {
          "username": "hexcode-dan"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cleaniq uses your location, only while you have it switched on for a job, so the customer can see when you're on the way."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5c8d571-8a34-42f6-8e30-13c968eacea1"
      }
    },
    "owner": "hexcode-dan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e5c8d571-8a34-42f6-8e30-13c968eacea1",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    }
  }
}
