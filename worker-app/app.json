{
  "expo": {
    "name": "Cleaniq Services Pro",
    "slug": "worker-app",
    "scheme": "cleaniqworker",
    "version": "1.2.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C43"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleaniq.worker",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Cleaniq uses your location, only while you have it switched on for a job, so the customer can see when you're on the way."
      }
    },
    "android": {
      "package": "com.cleaniq.worker",
      "adaptiveIcon": {
        "backgroundColor": "#0A5C43",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A5C43"
        }
      ],
      [
        "expo-updates",
        {
          "username": "hexmane99s-team"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cleaniq uses your location, only while you have it switched on for a job, so the customer can see when you're on the way."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "182cc56f-a629-4a07-8235-06fd4e07c6fb"
      }
    },
    "owner": "hexmane99s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/182cc56f-a629-4a07-8235-06fd4e07c6fb"
    }
  }
}
