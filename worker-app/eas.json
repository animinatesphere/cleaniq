{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "distribution": "store",
        "buildConfiguration": "Release",
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "autoIncrement": true
      },
      "env": {
        "GRADLE_OPTS": "-Xmx4096m -XX:+HeapDumpOnOutOfMemoryError",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "chigoziembaike1@icloud.com",
        "ascAppId": "6784165706"
      }
    }
  }
}
