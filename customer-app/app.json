{
  "expo": {
    "name": "Cleaniq Service",
    "slug": "cleaniq-customer",
    "scheme": "cleaniqcustomer",
    "version": "1.8.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C43"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleaniq.customer",
      "jsEngine": "hermes",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cleaniq.customer",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "backgroundColor": "#0A5C43",
        "foregroundImage": "./assets/icon.jpg"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-updates",
        {
          "username": "hexmane99s-team"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "3b274192-4aec-474b-b5c1-4c5a05438455"
      }
    },
    "owner": "hexmane99",
    "updates": {
      "url": "https://u.expo.dev/3b274192-4aec-474b-b5c1-4c5a05438455"
    }
  }
}
